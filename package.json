{
  "name": "food-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Discord bot for tracking food expiration dates in Notion.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "register:commands": "tsx src/scripts/registerCommands.ts"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "chrono-node": "^2.8.3",
    "discord.js": "^14.19.3",
    "dotenv": "^16.6.1",
    "luxon": "^3.7.1",
    "node-cron": "^4.2.1",
    "openai": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
